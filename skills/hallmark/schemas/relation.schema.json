{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kha997.github.io/hallmark/schemas/relation.schema.json",
  "title": "Hallmark Typed Relation",
  "type": "object",
  "required": ["id", "schemaVersion", "version", "status", "from", "relation", "to"],
  "properties": {
    "id": { "type": "string", "pattern": "^relation\\.[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "schemaVersion": { "type": "string", "format": "semver" },
    "version": { "type": "string", "format": "semver" },
    "status": { "enum": ["confirmed", "compatibility-placeholder", "proposed", "deprecated"] },
    "from": { "type": "string" },
    "relation": { "enum": ["uses", "supports", "constrains", "evaluates", "applies-to", "compatible-with", "conflicts-with"] },
    "to": { "type": "string" }
  },
  "additionalProperties": false
}
