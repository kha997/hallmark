{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kha997.github.io/hallmark/schemas/review-report.schema.json",
  "title": "Hallmark Review Report",
  "type": "object",
  "required": ["schemaVersion", "rubricId", "rubricVersion", "categories", "recommendations", "priorityFixes"],
  "properties": {
    "schemaVersion": { "type": "string", "format": "semver" },
    "rubricId": { "type": "string" },
    "rubricVersion": { "type": "string", "format": "semver" },
    "overall": { "type": ["number", "null"] },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "weight", "confidence", "notScored", "evidence", "applicableRules", "locations"],
        "properties": {
          "id": { "type": "string" },
          "score": { "type": ["number", "null"] },
          "weight": { "type": "number", "minimum": 0, "maximum": 1 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "notScored": { "type": "boolean" },
          "evidence": { "type": "array", "items": { "type": "string" } },
          "applicableRules": { "type": "array", "items": { "type": "string" } },
          "locations": { "type": "array", "items": { "type": "string" } }
        },
        "oneOf": [
          {
            "properties": {
              "notScored": { "const": true },
              "score": { "const": null }
            },
            "required": ["score"]
          },
          {
            "properties": {
              "notScored": { "const": false },
              "score": { "type": "number" }
            },
            "required": ["score"]
          }
        ],
        "additionalProperties": false
      }
    },
    "recommendations": { "type": "array", "items": { "type": "string" } },
    "priorityFixes": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": false
}
