{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kha997.github.io/hallmark/schemas/principle.schema.json",
  "title": "Hallmark Principle Entity",
  "type": "object",
  "required": ["id", "schemaVersion", "version", "status", "path", "dependencies", "appliesTo", "capabilities", "owns"],
  "properties": {
    "id": { "type": "string", "pattern": "^principle\\.[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "schemaVersion": { "type": "string", "format": "semver" },
    "version": { "type": "string", "format": "semver" },
    "status": { "enum": ["confirmed", "compatibility-placeholder", "proposed", "deprecated"] },
    "path": { "type": "string", "minLength": 1 },
    "dependencies": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "appliesTo": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "capabilities": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "owns": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
  },
  "additionalProperties": false
}
