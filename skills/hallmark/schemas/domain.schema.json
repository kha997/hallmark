{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kha997.github.io/hallmark/schemas/domain.schema.json",
  "title": "Hallmark Domain Entity",
  "type": "object",
  "required": ["id", "schemaVersion", "version", "status", "path", "signals", "dependencies", "owns"],
  "properties": {
    "id": { "type": "string", "pattern": "^domain\\.[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "schemaVersion": { "type": "string", "format": "semver" },
    "version": { "type": "string", "format": "semver" },
    "status": { "enum": ["confirmed", "compatibility-placeholder", "proposed", "deprecated"] },
    "path": { "type": "string", "minLength": 1 },
    "signals": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "dependencies": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "owns": { "type": "array", "uniqueItems": true, "items": { "type": "string" } }
  },
  "additionalProperties": false
}
